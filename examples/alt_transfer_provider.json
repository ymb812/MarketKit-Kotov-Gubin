{
  "openapi": "3.1.0",
  "info": {
    "title": "Example Transfer API",
    "version": "2026-09"
  },
  "servers": [
    {
      "url": "https://{region}.transfers.example/v2",
      "variables": {
        "region": {
          "default": "eu",
          "enum": ["eu", "us"],
          "description": "Processing region"
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/transfers": {
      "post": {
        "operationId": "initiateTransfer",
        "tags": ["Money movement"],
        "summary": "Initiate a transfer",
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferInput"
              },
              "example": {
                "value": "42.50",
                "asset": "EUR",
                "destination": {
                  "iban": "DE89370400440532013000"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": ["title"],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "violations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transfers/{transferId}": {
      "parameters": [
        {
          "name": "transferId",
          "in": "path",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "retrieveTransaction",
        "parameters": [
          {
            "name": "include",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fees", "history"]
              },
              "uniqueItems": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer state",
            "headers": {
              "X-Trace-ID": {
                "description": "Trace identifier",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "TransferInput": {
        "type": "object",
        "required": ["value", "asset", "destination"],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "example": "42.50"
          },
          "asset": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "example": "EUR"
          },
          "destination": {
            "type": "object",
            "required": ["iban"],
            "properties": {
              "iban": {
                "type": "string"
              }
            }
          }
        }
      },
      "TransferResult": {
        "type": "object",
        "required": ["transaction", "state"],
        "properties": {
          "transaction": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          },
          "state": {
            "type": "string",
            "enum": ["NEW", "SETTLED", "ERROR"]
          }
        }
      }
    }
  }
}

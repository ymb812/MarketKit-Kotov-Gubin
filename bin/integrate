#!/usr/bin/env ruby
# frozen_string_literal: true

project_root = File.expand_path("..", __dir__)
project_root = Dir.pwd unless File.file?(File.join(project_root, "lib", "integration_generator.rb"))
$LOAD_PATH.unshift(File.join(project_root, "lib"))

require "integration_generator"

exit IntegrationGenerator::CLI.start(ARGV)

#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "optparse"
require "integration_generator"
require "integration_generator/web/server"

options = { port: 9292 }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/serve [--port PORT]"
  parser.on("--port PORT", Integer, "Local port (default: 9292)") { |value| options[:port] = value }
end.parse!

abort "Port must be between 1 and 65535" unless options[:port].between?(1, 65_535)

IntegrationGenerator::Web::Server.new(root: File.expand_path("..", __dir__), port: options[:port]).start
